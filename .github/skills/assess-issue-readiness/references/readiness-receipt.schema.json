{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dotnet/aspnetcore/.github/skills/assess-issue-readiness/readiness-receipt.schema.json",
  "title": "ASP.NET Core issue readiness assessment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "generated_at",
    "instrumentation",
    "artifact_root",
    "source_repository",
    "issue",
    "assessed_repository",
    "environment",
    "upstream_triage",
    "investigation",
    "decision_signals",
    "checks",
    "check_summary",
    "commands",
    "evidence",
    "confidence",
    "reason_code",
    "primary_disposition",
    "supporting_findings",
    "missing_evidence",
    "blockers",
    "resolution_reference",
    "next_route",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "assessment_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "instrumentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "source",
        "timing",
        "tools",
        "model",
        "attempts",
        "cost"
      ],
      "properties": {
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evaluation_protocol_version", "cohort_version"],
          "properties": {
            "evaluation_protocol_version": { "const": "1.0" },
            "cohort_version": { "type": "string", "minLength": 1 }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skill_commit_sha", "artifacts", "manifest_sha256"],
          "properties": {
            "skill_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "artifacts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill_md_sha256",
                "disposition_policy_sha256",
                "receipt_schema_sha256",
                "validator_sha256"
              ],
              "properties": {
                "skill_md_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "disposition_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "receipt_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "validator_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            },
            "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "started_at",
            "ended_at",
            "wall_clock_seconds",
            "active_execution"
          ],
          "properties": {
            "started_at": { "type": "string", "format": "date-time" },
            "ended_at": { "type": "string", "format": "date-time" },
            "wall_clock_seconds": { "type": "number", "minimum": 0 },
            "active_execution": { "$ref": "#/$defs/nullableNonnegativeMeasurement" }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python",
            "git",
            "dotnet_sdk",
            "browser",
            "playwright",
            "domain_validator"
          ],
          "properties": {
            "python": { "$ref": "#/$defs/toolVersion" },
            "git": { "$ref": "#/$defs/toolVersion" },
            "dotnet_sdk": { "$ref": "#/$defs/toolVersion" },
            "browser": { "$ref": "#/$defs/toolVersion" },
            "playwright": { "$ref": "#/$defs/toolVersion" },
            "domain_validator": { "$ref": "#/$defs/toolVersion" }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine_identifier",
            "engine_version",
            "model_identifier",
            "model_version",
            "unknown_reason"
          ],
          "properties": {
            "engine_identifier": { "type": ["string", "null"] },
            "engine_version": { "type": ["string", "null"] },
            "model_identifier": { "type": ["string", "null"] },
            "model_version": { "type": ["string", "null"] },
            "unknown_reason": { "type": ["string", "null"] }
          }
        },
        "attempts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acquisition", "assessment", "reproduction"],
          "properties": {
            "acquisition": { "$ref": "#/$defs/nullableNonnegativeIntegerMeasurement" },
            "assessment": { "$ref": "#/$defs/nullableNonnegativeIntegerMeasurement" },
            "reproduction": { "$ref": "#/$defs/nullableNonnegativeIntegerMeasurement" }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency", "unit", "source", "unknown_reason"],
          "properties": {
            "amount": { "type": ["number", "null"], "minimum": 0 },
            "currency": { "type": ["string", "null"] },
            "unit": { "type": ["string", "null"] },
            "source": { "type": ["string", "null"] },
            "unknown_reason": { "type": ["string", "null"] }
          }
        }
      }
    },
    "artifact_root": { "type": "string", "minLength": 1 },
    "source_repository": { "const": "dotnet/aspnetcore" },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url", "revision"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/dotnet/aspnetcore/issues/[1-9][0-9]*$"
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["updated_at", "state", "state_reason"],
          "properties": {
            "updated_at": { "type": "string", "format": "date-time" },
            "state": { "enum": ["OPEN", "CLOSED"] },
            "state_reason": { "type": ["string", "null"] }
          }
        }
      }
    },
    "assessed_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "dirty", "path"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk", "tfm", "os", "render_mode"],
      "properties": {
        "sdk": { "type": ["string", "null"] },
        "tfm": { "type": ["string", "null"] },
        "os": { "type": ["string", "null"] },
        "render_mode": {
          "enum": [
            null,
            "static_ssr",
            "interactive_server",
            "interactive_webassembly",
            "interactive_auto",
            "standalone_webassembly",
            "not_applicable"
          ]
        }
      }
    },
    "upstream_triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "issue_type", "milestone", "missing_signals"],
      "properties": {
        "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "issue_type": { "type": ["string", "null"] },
        "milestone": { "type": ["string", "null"] },
        "missing_signals": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "highest_tier",
        "runtime_evidence_feasible",
        "released_sdk_first",
        "components_validator_delegated",
        "customer_signal",
        "release_signal",
        "budget_minutes",
        "search_budget",
        "execution_attempt_budget"
      ],
      "properties": {
        "highest_tier": { "type": "integer", "minimum": 0, "maximum": 4 },
        "runtime_evidence_feasible": { "type": "boolean" },
        "released_sdk_first": { "type": "boolean" },
        "components_validator_delegated": { "type": "boolean" },
        "customer_signal": { "enum": ["high", "normal", "low", "unknown"] },
        "release_signal": { "enum": ["high", "normal", "low", "unknown"] },
        "budget_minutes": { "type": "integer", "minimum": 1 },
        "search_budget": { "type": "integer", "minimum": 0 },
        "execution_attempt_budget": { "type": "integer", "minimum": 0 }
      }
    },
    "decision_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security_report",
        "verified_duplicate",
        "verified_already_fixed",
        "verified_by_design",
        "unsupported_usage",
        "invalid_or_incomplete_setup",
        "documentation_gap",
        "product_or_design_decision_required",
        "runtime_reproduced",
        "structural_failure_verified",
        "required_reporter_evidence_missing",
        "infrastructure_blocked",
        "runtime_attempted",
        "below_threshold"
      ],
      "properties": {
        "security_report": { "type": "boolean" },
        "verified_duplicate": { "type": "boolean" },
        "verified_already_fixed": { "type": "boolean" },
        "verified_by_design": { "type": "boolean" },
        "unsupported_usage": { "type": "boolean" },
        "invalid_or_incomplete_setup": { "type": "boolean" },
        "documentation_gap": { "type": "boolean" },
        "product_or_design_decision_required": { "type": "boolean" },
        "runtime_reproduced": { "type": "boolean" },
        "structural_failure_verified": { "type": "boolean" },
        "required_reporter_evidence_missing": { "type": "boolean" },
        "infrastructure_blocked": { "type": "boolean" },
        "runtime_attempted": { "type": "boolean" },
        "below_threshold": { "type": "boolean" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "passed", "failed", "skipped", "blocked"],
      "properties": {
        "attempted": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "reason_code": {
      "enum": [
        "security_boundary",
        "duplicate_verified",
        "already_fixed_verified",
        "upstream_by_design_verified",
        "unsupported_configuration_verified",
        "setup_invalid",
        "setup_incomplete",
        "documentation_gap_verified",
        "product_decision_needed",
        "api_design_needed",
        "runtime_failure_reproduced",
        "structural_failure_verified",
        "reporter_repro_missing",
        "environment_details_missing",
        "environment_blocked",
        "tooling_blocked",
        "bounded_repro_did_not_reproduce",
        "insufficient_customer_or_release_signal",
        "insufficient_evidence"
      ]
    },
    "primary_disposition": {
      "enum": [
        "security_process_required",
        "duplicate_or_already_fixed",
        "by_design",
        "unsupported_usage",
        "invalid_or_incomplete_setup",
        "documentation_gap",
        "product_or_design_decision_required",
        "ready_for_fix_investigation",
        "needs_reporter_evidence_or_repro",
        "infrastructure_blocked_or_inconclusive",
        "not_reproduced",
        "deferred_below_threshold"
      ]
    },
    "supporting_findings": { "type": "array", "items": { "type": "string" } },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "resolution_reference": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "evidence_ref"],
          "properties": {
            "kind": { "enum": ["issue", "pull_request", "release"] },
            "url": { "type": "string", "minLength": 1 },
            "evidence_ref": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "next_route": {
      "enum": [
        "security_reporting_process",
        "existing_issue_or_release",
        "stop_by_design",
        "supported_usage_guidance",
        "reporter_setup_correction",
        "documentation_owner",
        "maintainer_design_decision",
        "fix_investigation",
        "reporter_evidence",
        "infrastructure_or_retry",
        "maintainer_recheck_or_reporter_evidence",
        "defer"
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_mode",
        "assessment_mode",
        "execution_boundary",
        "hard_no_mutation_guarantee",
        "github_access",
        "github_mutations",
        "microsoft_365_writes",
        "fixes_proposed",
        "fixes_implemented",
        "reproduction_isolation",
        "credentials_removed",
        "acquisition_external_network_access",
        "assessment_external_network_access",
        "loopback_network_access",
        "writable_roots",
        "disposable_worktree_root",
        "cache_roots",
        "temp_roots"
      ],
      "properties": {
        "input_mode": {
          "enum": ["public_get_snapshot", "provided_offline_snapshot"]
        },
        "assessment_mode": {
          "enum": ["offline_no_credentials", "host_attested"]
        },
        "execution_boundary": {
          "enum": [
            "isolated_no_credentials_no_write_tools",
            "host_attestation"
          ]
        },
        "hard_no_mutation_guarantee": { "type": "boolean" },
        "github_access": {
          "enum": ["none", "public_get_only", "host_attested_read_only"]
        },
        "github_mutations": { "type": "array", "maxItems": 0 },
        "microsoft_365_writes": { "type": "array", "maxItems": 0 },
        "fixes_proposed": { "const": false },
        "fixes_implemented": { "const": false },
        "reproduction_isolation": {
          "enum": ["not_applicable", "sandboxed_no_credentials"]
        },
        "credentials_removed": { "type": "boolean" },
        "acquisition_external_network_access": {
          "enum": ["none", "public_github_get_only"]
        },
        "assessment_external_network_access": {
          "enum": ["none", "host_unrestricted"]
        },
        "loopback_network_access": { "type": "boolean" },
        "writable_roots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "disposable_worktree_root": {
          "type": ["string", "null"]
        },
        "cache_roots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "temp_roots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "nullableNonnegativeMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unknown_reason"],
      "properties": {
        "value": { "type": ["number", "null"], "minimum": 0 },
        "unknown_reason": { "type": ["string", "null"] }
      }
    },
    "nullableNonnegativeIntegerMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unknown_reason"],
      "properties": {
        "value": { "type": ["integer", "null"], "minimum": 0 },
        "unknown_reason": { "type": ["string", "null"] }
      }
    },
    "toolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "version", "unknown_reason"],
      "properties": {
        "used": { "type": "boolean" },
        "version": { "type": ["string", "null"] },
        "unknown_reason": { "type": ["string", "null"] }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "command_ids", "evidence_refs", "details"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["triage", "setup", "supported_usage", "history", "documentation", "proportionality", "reproduction", "in_tree"]
        },
        "status": { "enum": ["passed", "failed", "skipped", "blocked"] },
        "command_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "details": { "type": "string", "minLength": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "working_directory", "status", "exit_code", "stdout_ref", "stderr_ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "working_directory": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "blocked"] },
        "exit_code": { "type": ["integer", "null"] },
        "stdout_ref": { "type": ["string", "null"] },
        "stderr_ref": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["acquisition_manifest", "issue_snapshot", "release_snapshot", "comment_snapshot", "documentation", "history", "proportionality", "source", "repro_source", "command_output", "validator_output"]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
